export class BiblicalGenerator {
  constructor() {
    this.scenes = [];
    this.title = "Generador Bíblico 3D";
  }

  createProject(title) {
    this.title = title;
    this.scenes = [];
    return this;
  }

  addScene(description, duration = 10) {
    this.scenes.push({
      description,
      duration,
      id: crypto.randomUUID()
    });
    return this.scenes;
  }

  getProject() {
    return {
      title: this.title,
      scenes: this.scenes,
      totalDuration: this.scenes.reduce(
        (total, scene) => total + scene.duration, 0
      )
    };
  }
}
