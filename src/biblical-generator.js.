/**
 * Viz — Biblical Generator
 */

export class BiblicalGenerator {
  constructor() {
    this.scenes = [];
    this.title = "Generador Bíblico 3D";
  }

  createProject(title = "Generador Bíblico 3D") {
    this.title = title;
    this.scenes = [];
    return this;
  }

  addScene(description, duration = 10) {
    this.scenes.push({
      id: crypto.randomUUID(),
      description,
      duration
    });

    return this.scenes;
  }

  getProject() {
    return {
      title: this.title,
      scenes: this.scenes,
      totalDuration: this.scenes.reduce(
        (total, scene) => total + scene.duration,
        0
      )
    };
  }
}
